---
import BaseLayout from "../layouts/BaseLayout.astro";
import Nav from "../components/Nav.astro";
---

<BaseLayout
  title="Privacy | Stone Ridge Constructions LLC"
  description="Privacy policy for Stone Ridge Constructions LLC."
>
  <Nav />
  <main id="top" class="gutter overflow-x-hidden w-full max-w-full py-32 md:py-40">
    <h1
      class="max-w-[16ch] text-[clamp(2.2rem,4.4vw,4rem)] font-semibold leading-none tracking-[-0.04em]"
    >
      Privacy policy
    </h1>
    <p class="mt-6 max-w-[65ch] text-muted">
      Placeholder page. Final privacy wording ships before forms go live and
      collect personal data. Contact details will use the company domain, never a
      consumer mailbox.
    </p>
    <a class="btn btn-ink mt-10" href="/">Back to home <span class="ic" aria-hidden="true">↗</span></a>
  </main>
</BaseLayout>
