---
import BaseLayout from "../layouts/BaseLayout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
---

{/*
  Canonical privacy URL per site-copy. /privacy remains as an alias with the same content.
*/}

<BaseLayout
  title="Privacy Policy | Titan Core Builders LLC"
  description="Privacy policy for Titan Core Builders LLC."
>
  <Nav />
  <main id="top" class="gutter overflow-x-hidden w-full max-w-full py-32 md:py-40">
    <h1
      class="max-w-[16ch] text-[clamp(2.2rem,4.4vw,4rem)] font-semibold leading-none tracking-[-0.04em]"
    >
      Privacy policy
    </h1>
    <p class="mt-6 max-w-[65ch] text-muted">
      Placeholder page for Titan Core Builders LLC. Final privacy wording should
      identify the company, effective date, and approved business contact
      details; explain information collected through client and service partner
      forms; and cover use, retention, security, cookies or analytics, and how
      to make privacy requests. Because the partner form may collect business
      credentials and insurance status, the final policy should be reviewed by
      qualified U.S. counsel before publication. Contact:
      info@TitanCoreBuilders.com.
    </p>
    <a class="btn btn-ink mt-10" href="/"
      >Back to home <span class="ic" aria-hidden="true">↗</span></a
    >
  </main>
  <Footer />
</BaseLayout>
