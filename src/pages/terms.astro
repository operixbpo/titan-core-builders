---
import BaseLayout from "../layouts/BaseLayout.astro";
import Nav from "../components/Nav.astro";
---

<BaseLayout
  title="Terms | Stone Ridge Constructions LLC"
  description="Terms of use for Stone Ridge Constructions LLC."
>
  <Nav />
  <main id="top" class="gutter overflow-x-hidden w-full max-w-full py-32 md:py-40">
    <h1
      class="max-w-[16ch] text-[clamp(2.2rem,4.4vw,4rem)] font-semibold leading-none tracking-[-0.04em]"
    >
      Terms of use
    </h1>
    <p class="mt-6 max-w-[65ch] text-muted">
      Placeholder page. Final terms ship before production launch, covering quote
      requests, vendor applications and site use.
    </p>
    <a class="btn btn-ink mt-10" href="/">Back to home <span class="ic" aria-hidden="true">↗</span></a>
  </main>
</BaseLayout>
