---
import BaseLayout from "../layouts/BaseLayout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
---

<BaseLayout
  title="Terms of Use | Titan Core Builders LLC"
  description="Terms of use for Titan Core Builders LLC."
>
  <Nav />
  <main id="top" class="gutter overflow-x-hidden w-full max-w-full py-32 md:py-40">
    <h1
      class="max-w-[16ch] text-[clamp(2.2rem,4.4vw,4rem)] font-semibold leading-none tracking-[-0.04em]"
    >
      Terms of use
    </h1>
    <p class="mt-6 max-w-[65ch] text-muted">
      Placeholder page for Titan Core Builders LLC. Final terms should explain
      that website information is general, a submitted form does not create a
      service agreement, estimates and schedules require written confirmation,
      services may be performed through approved service partners, and
      availability depends on location and scope. Client contracts, work orders,
      and partner agreements remain in separate signed documents. Contact:
      info@TitanCoreBuilders.com.
    </p>
    <a class="btn btn-ink mt-10" href="/">Back to home <span class="ic" aria-hidden="true">↗</span></a>
  </main>
  <Footer />
</BaseLayout>
