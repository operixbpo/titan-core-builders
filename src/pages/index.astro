---
import BaseLayout from "../layouts/BaseLayout.astro";
import Nav from "../components/Nav.astro";
import LeadForm from "../components/LeadForm.astro";
import Footer from "../components/Footer.astro";
---

{/*
  Copy source: docs/site-copy.md (30 Sep 2026).
  About + Coverage stay as in-page home sections (/#about, /#coverage).
  Services → /services, Contact → /contact (built as separate pages).
*/}

<BaseLayout>
  <Nav />

  <main id="top" class="overflow-x-hidden w-full max-w-full">
    <!-- HERO -->
    <section
      class="gutter grid min-h-[100dvh] grid-cols-1 items-center gap-10 pb-12 pt-28 lg:grid-cols-[minmax(0,7fr)_minmax(0,5fr)] lg:gap-16 lg:pt-24"
    >
      <div>
        <p
          class="mb-6 inline-flex items-center gap-2 rounded-full bg-surface px-3 py-1.5 text-sm text-muted shadow-[inset_0_0_0_1px_var(--color-line)]"
          id="heroKick"
        >
          <span
            class="fi fi-rr-tools text-[0.95rem]"
            aria-hidden="true"
          ></span>
          Property maintenance and preservation
        </p>
        <h1
          id="heroTitle"
          class="max-w-5xl text-[clamp(2.8rem,5.7vw,5.9rem)] font-semibold leading-[1.05] tracking-[-0.04em]"
        >
          Reliable Property Services Across <span class="mark" id="mark"
            >Multiple Markets</span
          >
        </h1>
        <p class="hero-sub mt-7 max-w-[44ch] text-lg font-light text-muted">
          Titan Core Builders LLC coordinates licensed and insured service
          professionals for maintenance, preservation, inspection, and repair
          work. We respond quickly, communicate clearly, and document completed
          work with photos.
        </p>
        <div class="hero-sub mt-9 flex flex-wrap gap-3">
          <a class="btn btn-ink" href="/contact" data-magnetic
            >Request a Quote <span class="ic" aria-hidden="true"
              ><span class="fi fi-rr-arrow-up-right"></span></span
            ></a
          >
          <a class="btn btn-line" href="/contact#vendor"
            >Become a Service Partner</a
          >
        </div>
      </div>
      <div class="relative h-[min(76vh,46rem)] min-h-[26rem]">
        <div class="hero-frame h-full overflow-hidden rounded-[34px]">
          <img
            class="photo h-full w-full object-cover object-[40%_50%]"
            id="heroImg"
            src="/img/roofer-shingles.jpg"
            alt="Roofer fixing asphalt shingles with a nail gun"
            width="1200"
            height="1600"
            fetchpriority="high"
          />
        </div>
        <div class="order" id="order" aria-label="Example work order">
          <div class="flex justify-between text-[0.8rem] text-muted">
            <span>Work order</span><span>Board-up</span>
          </div>
          <p class="mb-3 mt-1.5 text-[1.05rem] font-semibold">
            Secure rear windows
          </p>
          <ul>
            <li>Crew dispatched <span class="tag done">Done</span></li>
            <li>Before photos <span class="tag done">Done</span></li>
            <li>Windows boarded <span class="tag done">Done</span></li>
            <li>After photos <span class="tag" id="orderLast">Sending</span></li>
          </ul>
        </div>
      </div>
    </section>

    <!-- MARQUEE -->
    <section class="grid gap-2 py-16 md:py-24" aria-label="Supported trades">
      <div class="row" id="r1">
        <span
          >Maintenance <i></i> Preservation <i></i> Inspection <i></i> Repair
          coordination <i></i></span
        >
        <span aria-hidden="true"
          >Maintenance <i></i> Preservation <i></i> Inspection <i></i> Repair
          coordination <i></i></span
        >
      </div>
      <div class="row outline" id="r2" aria-hidden="true">
        <span
          >Plumbing <i></i> Electrical <i></i> HVAC <i></i> Lawn care <i></i>
          Winterization <i></i></span
        >
        <span
          >Plumbing <i></i> Electrical <i></i> HVAC <i></i> Lawn care <i></i>
          Winterization <i></i></span
        >
      </div>
    </section>

    <!-- ABOUT -->
    <section class="gutter py-24 md:py-40" id="about">
      <p
        class="intro max-w-[28ch] text-[clamp(2rem,4.3vw,4.5rem)] font-medium leading-[1.08] tracking-[-0.035em]"
        id="intro"
      >
        About Titan Core Builders
      </p>
      <p class="mt-8 max-w-[62ch] text-lg text-muted">
        Titan Core Builders LLC is a Virginia-registered property services
        company supporting property managers, institutional clients, and
        homeowners. We coordinate qualified service professionals, clear
        estimates, and documented completion for routine and urgent work
        orders. Our goal is simple: complete the approved scope, keep the
        client informed, and provide a clear record of the work performed.
      </p>
      <div class="facts mt-20 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
        <div
          class="fact rounded-[24px] bg-surface p-6 shadow-[inset_0_0_0_1px_var(--color-line)]"
        >
          <span class="icon-chip soft" aria-hidden="true"
            ><span class="fi fi-rr-badge-check"></span></span
          >
          <p class="text-[1.7rem] font-semibold leading-none tracking-[-0.04em]"
            >Licensed</p
          >
          <p class="mt-6 text-muted"
            >Work coordinated through licensed and insured professionals as
            required for the service and location.</p
          >
        </div>
        <div
          class="fact rounded-[24px] bg-surface p-6 shadow-[inset_0_0_0_1px_var(--color-line)]"
        >
          <span class="icon-chip soft" aria-hidden="true"
            ><span class="fi fi-rr-camera"></span></span
          >
          <p class="text-[1.7rem] font-semibold leading-none tracking-[-0.04em]"
            >Documented</p
          >
          <p class="mt-6 text-muted"
            >Completed work supported by before, during, and after photos when
            the assignment requires them.</p
          >
        </div>
        <div
          class="fact rounded-[24px] bg-surface p-6 shadow-[inset_0_0_0_1px_var(--color-line)]"
        >
          <span class="icon-chip soft" aria-hidden="true"
            ><span class="fi fi-rr-time-fast"></span></span
          >
          <p class="text-[1.7rem] font-semibold leading-none tracking-[-0.04em]"
            >Responsive</p
          >
          <p class="mt-6 text-muted"
            >We acknowledge requests quickly and coordinate the next practical
            step — including after-hours urgent needs.</p
          >
        </div>
        <div class="fact rounded-[24px] bg-hivis-soft p-6">
          <span class="icon-chip on-hivis" aria-hidden="true"
            ><span class="fi fi-rr-map-marker"></span></span
          >
          <p class="text-[1.7rem] font-semibold leading-none tracking-[-0.04em]"
            >Multi-state</p
          >
          <p class="mt-6"
            >Service partner network supporting selected markets across five
            launch states.</p
          >
        </div>
      </div>
    </section>

    <!-- SERVICES -->
    <section class="gutter pb-16 md:pb-24" id="services">
      <div class="mb-12 flex flex-wrap items-end justify-between gap-x-12 gap-y-4">
        <h2
          class="max-w-[14ch] text-[clamp(2.2rem,4.4vw,4rem)] font-semibold leading-none tracking-[-0.04em]"
        >
          Property Services in One Place
        </h2>
        <p class="max-w-[36ch] text-muted">
          From routine upkeep to vacant-property preservation and condition
          reporting, our team coordinates the work required to keep residential
          properties secure, functional, and ready for occupancy or sale.
        </p>
      </div>
      <article class="card" style="--i:0">
        <figure>
          <img
            class="photo"
            src="/img/snow-street.jpg"
            alt="Snowy street with a white house behind pine trees"
            loading="lazy"
            width="900"
            height="700"
          />
        </figure>
        <div class="flex flex-col justify-between gap-8 p-2 md:p-6 md:pl-0">
          <div>
            <span class="tag px-3 py-1 text-sm"
              ><span class="fi fi-rr-house-lock" aria-hidden="true"></span
              >Preservation</span
            >
            <h3
              class="mt-4 text-[clamp(2rem,3.6vw,3.2rem)] font-semibold leading-none tracking-[-0.04em]"
            >
              Keep vacant properties secure and ready.
            </h3>
            <p class="mt-4 max-w-[38ch] text-muted">
              Services for vacant, distressed, and managed properties, including
              securing, debris removal, lawn maintenance, winterization, repair
              coordination, and recurring upkeep.
            </p>
          </div>
          <ul class="grid grid-cols-2 gap-x-4 gap-y-2 text-[0.95rem]">
            <li class="flex items-center gap-2"
              ><span class="fi fi-rr-lock icon-inline" aria-hidden="true"
              ></span>Securing and boarding</li
            >
            <li class="flex items-center gap-2"
              ><span class="fi fi-rr-broom icon-inline" aria-hidden="true"
              ></span>Debris removal</li
            >
            <li class="flex items-center gap-2"
              ><span class="fi fi-rr-snowflake icon-inline" aria-hidden="true"
              ></span>Winterization</li
            >
            <li class="flex items-center gap-2"
              ><span class="fi fi-rr-house-chimney icon-inline" aria-hidden="true"
              ></span>Vacant property upkeep</li
            >
          </ul>
        </div>
      </article>
      <article class="card" style="--i:1">
        <figure>
          <img
            class="photo"
            src="/img/lawn-mowing-2.jpg"
            alt="Close view of a lawn mower cutting grass"
            loading="lazy"
            width="900"
            height="700"
          />
        </figure>
        <div class="flex flex-col justify-between gap-8 p-2 md:p-6 md:pl-0">
          <div>
            <span class="tag px-3 py-1 text-sm"
              ><span class="fi fi-rr-wrench-simple" aria-hidden="true"></span
              >Maintenance</span
            >
            <h3
              class="mt-4 text-[clamp(2rem,3.6vw,3.2rem)] font-semibold leading-none tracking-[-0.04em]"
            >
              Routine and corrective property care.
            </h3>
            <p class="mt-4 max-w-[38ch] text-muted">
              Interior and exterior needs including general repairs, painting,
              carpentry, plumbing, electrical, HVAC coordination, lawn care, and
              seasonal service.
            </p>
          </div>
          <ul class="grid grid-cols-2 gap-x-4 gap-y-2 text-[0.95rem]">
            <li class="flex items-center gap-2"
              ><span class="fi fi-rr-hammer icon-inline" aria-hidden="true"
              ></span>General repairs</li
            >
            <li class="flex items-center gap-2"
              ><span class="fi fi-rr-plug icon-inline" aria-hidden="true"
              ></span>Plumbing &amp; electrical</li
            >
            <li class="flex items-center gap-2"
              ><span class="fi fi-rr-seedling icon-inline" aria-hidden="true"
              ></span>Lawn and seasonal care</li
            >
            <li class="flex items-center gap-2"
              ><span class="fi fi-rr-home icon-inline" aria-hidden="true"
              ></span>Turnover / make-ready</li
            >
          </ul>
        </div>
      </article>
      <article class="card" style="--i:2">
        <figure>
          <img
            class="photo"
            src="/img/inspector-checklist.jpg"
            alt="Inspector holding a checklist on a clipboard"
            loading="lazy"
            width="900"
            height="700"
          />
        </figure>
        <div class="flex flex-col justify-between gap-8 p-2 md:p-6 md:pl-0">
          <div>
            <span class="tag px-3 py-1 text-sm"
              ><span class="fi fi-rr-clipboard-list-check" aria-hidden="true"
              ></span>Inspection</span
            >
            <h3
              class="mt-4 text-[clamp(2rem,3.6vw,3.2rem)] font-semibold leading-none tracking-[-0.04em]"
            >
              Clear condition reporting with photos.
            </h3>
            <p class="mt-4 max-w-[38ch] text-muted">
              Property condition inspections with clear observations and photo
              documentation to support maintenance decisions, repair planning,
              and ongoing asset management.
            </p>
          </div>
          <ul class="grid grid-cols-2 gap-x-4 gap-y-2 text-[0.95rem]">
            <li class="flex items-center gap-2"
              ><span class="fi fi-rr-search icon-inline" aria-hidden="true"
              ></span>Condition inspections</li
            >
            <li class="flex items-center gap-2"
              ><span class="fi fi-rr-key icon-inline" aria-hidden="true"
              ></span>Rental / occupancy checks</li
            >
            <li class="flex items-center gap-2"
              ><span class="fi fi-rr-house-building icon-inline" aria-hidden="true"
              ></span>Pre-listing</li
            >
            <li class="flex items-center gap-2"
              ><span class="fi fi-rr-file-invoice icon-inline" aria-hidden="true"
              ></span>Insurance &amp; foreclosure</li
            >
          </ul>
        </div>
      </article>
    </section>

    <!-- HOW IT WORKS -->
    <section
      class="gutter grid grid-cols-1 gap-12 py-24 md:py-40 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:gap-20"
      id="how"
    >
      <div class="how-title self-start lg:sticky lg:top-32">
        <h2
          class="max-w-[12ch] text-[clamp(2.2rem,4.4vw,4rem)] font-semibold leading-none tracking-[-0.04em]"
        >
          From request to documented completion.
        </h2>
        <p class="mt-6 max-w-[36ch] text-muted">
          Share the property location and scope. We confirm coverage, review the
          work, and keep you informed through completion.
        </p>
        <a class="btn btn-ink mt-8" href="/contact"
          >Request a Quote <span class="ic" aria-hidden="true"
            ><span class="fi fi-rr-arrow-up-right"></span></span
          ></a
        >
      </div>
      <div class="relative" id="steps">
        <div class="rail" aria-hidden="true"><i id="railFill"></i></div>
        <div class="step on">
          <span class="num">1</span>
          <div>
            <h3 class="flex flex-wrap items-center gap-2.5 text-2xl font-semibold tracking-[-0.02em]"
              ><span class="fi fi-rr-comment icon-inline" aria-hidden="true"
              ></span>Tell us what the property needs</h3
            >
            <p class="mt-2 max-w-[44ch] text-muted">
              Use the quote form or contact us by phone or email. Include the
              address, requested service, photos when available, and any
              scheduling requirements.
            </p>
            <figure>
              <img
                class="photo"
                src="/img/aerial-street.jpg"
                alt="Aerial view down a residential street"
                loading="lazy"
                width="800"
                height="450"
              />
            </figure>
          </div>
        </div>
        <div class="step">
          <span class="num">2</span>
          <div>
            <h3 class="flex flex-wrap items-center gap-2.5 text-2xl font-semibold tracking-[-0.02em]"
              ><span class="fi fi-rr-map-marker icon-inline" aria-hidden="true"
              ></span>We confirm coverage and review scope</h3
            >
            <p class="mt-2 max-w-[44ch] text-muted">
              Our team checks service availability for the ZIP code and advises
              on the next practical step.
            </p>
          </div>
        </div>
        <div class="step">
          <span class="num">3</span>
          <div>
            <h3 class="flex flex-wrap items-center gap-2.5 text-2xl font-semibold tracking-[-0.02em]"
              ><span class="fi fi-rr-file-invoice icon-inline" aria-hidden="true"
              ></span>Estimate and schedule</h3
            >
            <p class="mt-2 max-w-[44ch] text-muted">
              Estimates separate labor and material costs and identify
              assumptions or exclusions before work is approved in writing.
            </p>
            <figure>
              <img
                class="photo"
                src="/img/window-repair.jpg"
                alt="Worker repairing a window frame"
                loading="lazy"
                style="object-position:50% 40%"
                width="800"
                height="450"
              />
            </figure>
          </div>
        </div>
        <div class="step">
          <span class="num">4</span>
          <div>
            <h3 class="flex flex-wrap items-center gap-2.5 text-2xl font-semibold tracking-[-0.02em]"
              ><span
                class="fi fi-rr-user-helmet-safety icon-inline"
                aria-hidden="true"></span
              >Qualified professionals complete the work</h3
            >
            <p class="mt-2 max-w-[44ch] text-muted">
              Licensed and insured service partners carry out the approved
              scope, with clear updates on scheduling and changes.
            </p>
          </div>
        </div>
        <div class="step !pb-0">
          <span class="num">5</span>
          <div>
            <h3 class="flex flex-wrap items-center gap-2.5 text-2xl font-semibold tracking-[-0.02em]"
              ><span class="fi fi-rr-camera icon-inline" aria-hidden="true"
              ></span>Photo-documented completion</h3
            >
            <p class="mt-2 max-w-[44ch] text-muted">
              Scope, documentation, and completion details are reviewed before a
              work order is closed.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- ILLUSTRATIVE GALLERY (not a published portfolio) -->
    <section id="work">
      <div class="proof-pin flex h-[100dvh] flex-col justify-center gap-10">
        <div
          class="gutter flex flex-wrap items-end justify-between gap-x-8 gap-y-4"
        >
          <h2
            class="max-w-[15ch] text-[clamp(2.2rem,4.4vw,4rem)] font-semibold leading-none tracking-[-0.04em]"
          >
            The kinds of work we coordinate.
          </h2>
          <p class="max-w-[34ch] text-muted">
            Illustrative job types across maintenance, preservation, and
            inspection. Project photos replace these when Titan has approved
            work it can publish.
          </p>
        </div>
        <div class="ptrack" id="ptrack">
          <figure class="shot w2">
            <img
              src="/img/roof-repair-crew.jpg"
              alt="Crew replacing a roof on a brick house"
              loading="lazy"
              width="900"
              height="600"
            />
            <figcaption
              ><b>Roof repair</b><span>Maintenance</span></figcaption
            >
          </figure>
          <figure class="shot w1">
            <img
              src="/img/inspector-window.jpg"
              alt="Inspector checking a window"
              loading="lazy"
              width="600"
              height="600"
            />
            <figcaption><b>Inspection</b></figcaption>
          </figure>
          <figure class="shot w2">
            <img
              src="/img/lawn-mowing.jpg"
              alt="Lawn being mowed"
              loading="lazy"
              width="900"
              height="600"
            />
            <figcaption><b>Lawn care</b><span>Recurring</span></figcaption>
          </figure>
          <figure class="shot w1">
            <img
              src="/img/repair-switch.jpg"
              alt="Electrician fixing a wall switch"
              loading="lazy"
              width="600"
              height="600"
            />
            <figcaption><b>Electrical</b></figcaption>
          </figure>
          <figure class="shot w2">
            <img
              src="/img/snow-modern.jpg"
              alt="Modern house in snow"
              loading="lazy"
              width="900"
              height="600"
            />
            <figcaption
              ><b>Winterization</b><span>Preservation</span></figcaption
            >
          </figure>
          <figure class="shot w1">
            <img
              src="/img/inspector-kneel.jpg"
              alt="Inspector checking a floor vent"
              loading="lazy"
              width="600"
              height="600"
            />
            <figcaption><b>Condition report</b></figcaption>
          </figure>
          <figure class="shot w2">
            <img
              src="/img/room-hardwood.jpg"
              alt="Empty room with hardwood floor"
              loading="lazy"
              width="900"
              height="600"
            />
            <figcaption><b>Cleanout</b><span>Debris removal</span></figcaption>
          </figure>
        </div>
      </div>
    </section>

    <!-- WHY CHOOSE US -->
    <section class="gutter py-24 md:py-40" id="why">
      <div class="mb-12 flex flex-wrap items-end justify-between gap-x-12 gap-y-4">
        <h2
          class="max-w-[16ch] text-[clamp(2.2rem,4.4vw,4rem)] font-semibold leading-none tracking-[-0.04em]"
        >
          Dependable Service and Clear Documentation
        </h2>
        <p class="max-w-[36ch] text-muted">
          Licensed professionals, photo records, and clear updates on estimates,
          scheduling, and completion.
        </p>
      </div>
      <div class="bento">
        <article class="b b-a">
          <div>
            <span class="icon-chip soft" aria-hidden="true"
              ><span class="fi fi-rr-camera"></span></span
            >
            <h3>Photo documentation</h3>
            <p class="mt-2 max-w-[40ch]">
              Completed work is supported by before, during, and after photos
              when the assignment requires them.
            </p>
          </div>
          <div class="report" aria-label="Example report">
            <div class="pair">
              <figure>
                <img
                  class="photo"
                  src="/img/room-shadow.jpg"
                  alt=""
                  loading="lazy"
                  width="400"
                  height="300"
                />
                <figcaption><span class="tag grey">Before</span></figcaption>
              </figure>
              <figure>
                <img
                  class="photo"
                  src="/img/room-bright.jpg"
                  alt=""
                  loading="lazy"
                  width="400"
                  height="300"
                />
                <figcaption><span class="tag done">After</span></figcaption>
              </figure>
            </div>
            <div class="rounded-[6px] bg-surface px-2" id="checks">
              <div class="check"
                >Debris removed <span class="tag">Pending</span></div
              >
              <div class="check"
                >Floors swept <span class="tag">Pending</span></div
              >
              <div class="check"
                >Locks checked <span class="tag">Pending</span></div
              >
              <div class="check"
                >Leak under kitchen sink <span class="tag grey">Needs you</span
                ></div
              >
            </div>
          </div>
        </article>
        <article class="b b-b">
          <div>
            <span class="icon-chip soft" aria-hidden="true"
              ><span class="fi fi-rr-messages"></span></span
            >
            <h3>Reliable communication</h3>
            <p class="mt-2">
              Clients receive clear updates on estimates, scheduling, changes,
              and completion.
            </p>
          </div>
          <div class="grid gap-2 sm:grid-cols-[1fr_auto]">
            <div class="typer" aria-hidden="true">
              <span id="typer"></span><span class="caret"></span>
            </div>
            <span class="btn btn-ink pointer-events-none"
              >Quote <span class="ic"
                ><span class="fi fi-rr-arrow-up-right"></span></span
              ></span
            >
          </div>
        </article>
        <article class="b b-c min-h-[17rem]">
          <img
            src="/img/worker-smile.jpg"
            alt="Smiling contractor in a hard hat"
            loading="lazy"
            width="600"
            height="600"
          />
          <div class="scrim" aria-hidden="true"></div>
          <div>
            <h3>Vetted professionals</h3>
            <p class="mt-1 !text-ink/70"
              >Reviewed for experience, coverage, and required documentation.</p
            >
          </div>
        </article>
        <article class="b">
          <div>
            <span class="icon-chip soft" aria-hidden="true"
              ><span class="fi fi-rr-check-circle"></span></span
            >
            <h3>Quality assurance</h3>
            <p class="mt-1">
              Scope, documentation, and completion details are reviewed before a
              work order is closed.
            </p>
          </div>
          <div class="cal" aria-hidden="true">
            <span>1</span><span>2</span><span class="v">3</span><span>4</span
            ><span>5</span><span>6</span><span>7</span>
            <span>8</span><span>9</span><span>10</span><span>11</span
            ><span class="v">12</span><span>13</span><span>14</span>
            <span>15</span><span>16</span><span class="v">17</span><span>18</span
            ><span>19</span><span>20</span><span>21</span>
          </div>
        </article>
      </div>
    </section>

    <!-- COVERAGE -->
    <section class="gutter py-24 md:py-32" id="coverage">
      <div class="flex flex-wrap items-end justify-between gap-x-12 gap-y-6">
        <div>
          <h2
            class="max-w-[14ch] text-[clamp(2.2rem,4.4vw,4rem)] font-semibold leading-none tracking-[-0.04em]"
          >
            Current Service Coverage
          </h2>
          <p class="mt-6 max-w-[52ch] text-muted">
            Titan Core Builders currently coordinates property services in
            selected markets across Virginia, Michigan, New York, Texas, and
            Washington. Contact us with the property ZIP code so we can confirm
            service availability.
          </p>
        </div>
        <a class="btn btn-line" href="/contact"
          >Contact Us <span class="ic" aria-hidden="true"
            ><span class="fi fi-rr-arrow-up-right"></span></span
          ></a
        >
      </div>
      <ul
        class="mt-12 grid grid-cols-2 gap-3 sm:grid-cols-3 md:grid-cols-5"
        aria-label="Launch markets"
      >
        {
          ["Virginia", "Michigan", "New York", "Texas", "Washington"].map(
            (state) => (
              <li class="flex flex-col items-center gap-3 rounded-[24px] bg-surface px-5 py-6 text-center font-semibold shadow-[inset_0_0_0_1px_var(--color-line)]">
                <span class="icon-chip soft" aria-hidden="true">
                  <span class="fi fi-rr-map-marker" />
                </span>
                {state}
              </li>
            ),
          )
        }
      </ul>
      <p class="mt-6 text-sm text-muted">
        Launch placeholder — confirm each state and any city-level limits before
        publication.
      </p>
    </section>

    <!-- SERVICE PARTNER CTA -->
    <section
      class="mx-[var(--gutter)] grid grid-cols-1 items-end gap-10 rounded-[34px] bg-ink p-8 text-white md:p-16 lg:grid-cols-[minmax(0,7fr)_minmax(0,5fr)]"
      id="partners"
    >
      <div>
        <h2
          class="max-w-[14ch] text-[clamp(2.4rem,5vw,4.8rem)] font-semibold leading-[0.98] tracking-[-0.045em]"
        >
          Work With Titan Core Builders
        </h2>
        <p class="mt-5 max-w-[40ch] text-lg text-white/70">
          Are you an experienced property maintenance professional or service
          company? Tell us about your trades, coverage area, licenses, and
          insurance. Our operations team will review your information and
          contact you if your services match an active market need.
        </p>
        <a
          class="btn btn-hivis mt-8"
          href="/contact#vendor"
          data-magnetic
          >Become a Service Partner <span class="ic" aria-hidden="true"
            ><span class="fi fi-rr-arrow-up-right"></span></span
          ></a
        >
      </div>
      <ul class="req grid gap-2.5">
        <li
          class="flex justify-between gap-4 rounded-2xl bg-white/10 px-5 py-4 font-medium shadow-[inset_0_0_0_1px_rgb(255_255_255/0.12)]"
        >
          <span class="flex items-center gap-2.5"
            ><span class="fi fi-rr-diploma text-[var(--color-hivis)]" aria-hidden="true"></span>You bring</span
          >
          <span class="font-normal text-white/65"
            >Licenses and insurance</span
          >
        </li>
        <li
          class="flex justify-between gap-4 rounded-2xl bg-white/10 px-5 py-4 font-medium shadow-[inset_0_0_0_1px_rgb(255_255_255/0.12)]"
        >
          <span class="flex items-center gap-2.5"
            ><span class="fi fi-rr-tools text-[var(--color-hivis)]" aria-hidden="true"></span>Tell us</span
          >
          <span class="font-normal text-white/65"
            >Trades and coverage area</span
          >
        </li>
        <li
          class="flex justify-between gap-4 rounded-2xl bg-white/10 px-5 py-4 font-medium shadow-[inset_0_0_0_1px_rgb(255_255_255/0.12)]"
        >
          <span class="flex items-center gap-2.5"
            ><span class="fi fi-rr-file-invoice text-[var(--color-hivis)]" aria-hidden="true"
            ></span
            >Onboarding</span
          >
          <span class="font-normal text-white/65"
            >W-9 and partner agreement</span
          >
        </li>
        <li
          class="flex justify-between gap-4 rounded-2xl bg-white/10 px-5 py-4 font-medium shadow-[inset_0_0_0_1px_rgb(255_255_255/0.12)]"
        >
          <span class="flex items-center gap-2.5"
            ><span class="fi fi-rr-wallet text-[var(--color-hivis)]" aria-hidden="true"></span>Payment</span
          >
          <span class="text-right font-normal text-white/65"
            >Per executed partner agreement</span
          >
        </li>
      </ul>
    </section>

    <!-- FAQ -->
    <section
      class="gutter grid grid-cols-1 gap-10 py-24 md:py-40 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:gap-20"
      id="faq"
    >
      <div class="self-start lg:sticky lg:top-32">
        <h2
          class="max-w-[12ch] text-[clamp(2.2rem,4.4vw,4rem)] font-semibold leading-none tracking-[-0.04em]"
        >
          Frequently asked questions
        </h2>
        <p class="mt-5 max-w-[34ch] text-muted">
          Something else? Ask in the contact form and we will answer with next
          steps.
        </p>
      </div>
      <div id="faqList">
        <div class="qa" data-open>
          <button aria-expanded="true" aria-controls="a1" id="q1"
            >What services do you provide?<span class="pm" aria-hidden="true"
            ></span></button
          >
          <div class="ans" id="a1" role="region" aria-labelledby="q1">
            <div>
              <p>
                We coordinate property maintenance, preservation, inspection,
                and general repair work. Supported trades may include plumbing,
                electrical, HVAC, painting, carpentry, lawn care, debris
                removal, winterization, turnover work, and related services.
              </p>
            </div>
          </div>
        </div>
        <div class="qa">
          <button aria-expanded="false" aria-controls="a2" id="q2"
            >Which areas do you serve?<span class="pm" aria-hidden="true"
            ></span></button
          >
          <div class="ans" id="a2" role="region" aria-labelledby="q2">
            <div>
              <p>
                Our launch coverage includes selected markets in Virginia,
                Michigan, New York, Texas, and Washington. Service availability
                depends on the property location and the requested trade. Send
                us the ZIP code and scope so we can confirm coverage.
              </p>
            </div>
          </div>
        </div>
        <div class="qa">
          <button aria-expanded="false" aria-controls="a3" id="q3"
            >How do I request an estimate?<span class="pm" aria-hidden="true"
            ></span></button
          >
          <div class="ans" id="a3" role="region" aria-labelledby="q3">
            <div>
              <p>
                Use the Request a Quote form or contact us by phone or email.
                Include the property address, requested service, photos when
                available, and any scheduling requirements. We will review the
                scope and advise on the next step.
              </p>
            </div>
          </div>
        </div>
        <div class="qa">
          <button aria-expanded="false" aria-controls="a4" id="q4"
            >Do you provide emergency support?<span class="pm" aria-hidden="true"
            ></span></button
          >
          <div class="ans" id="a4" role="region" aria-labelledby="q4">
            <div>
              <p>
                After-hours requests are accepted for urgent property needs.
                Response time and availability depend on the location, trade,
                site access, and nature of the issue.
              </p>
            </div>
          </div>
        </div>
        <div class="qa">
          <button aria-expanded="false" aria-controls="a5" id="q5"
            >How do service professionals get started?<span
              class="pm"
              aria-hidden="true"></span></button
          >
          <div class="ans" id="a5" role="region" aria-labelledby="q5">
            <div>
              <p>
                Complete the Become a Service Partner form with your contact
                information, coverage area, trades, and business credentials. If
                your services match a current need, our team will contact you
                about onboarding requirements.
              </p>
            </div>
          </div>
        </div>
        <div class="qa">
          <button aria-expanded="false" aria-controls="a6" id="q6"
            >Do you use standard pricing?<span class="pm" aria-hidden="true"
            ></span></button
          >
          <div class="ans" id="a6" role="region" aria-labelledby="q6">
            <div>
              <p>
                Pricing depends on the approved scope, property condition,
                labor, materials, access, timing, and local market. Estimates
                should separate labor and material costs and identify any
                assumptions or exclusions.
              </p>
            </div>
          </div>
        </div>
        <div class="qa">
          <button aria-expanded="false" aria-controls="a7" id="q7"
            >How are service partners paid?<span class="pm" aria-hidden="true"
            ></span></button
          >
          <div class="ans" id="a7" role="region" aria-labelledby="q7">
            <div>
              <p>
                Approved service partners are paid according to the terms in
                their executed agreement. Payment method, documentation
                requirements, and timing are confirmed during onboarding.
              </p>
            </div>
          </div>
        </div>
        <div class="qa">
          <button aria-expanded="false" aria-controls="a8" id="q8"
            >What documents may be required from a service partner?<span
              class="pm"
              aria-hidden="true"></span></button
          >
          <div class="ans" id="a8" role="region" aria-labelledby="q8">
            <div>
              <p>
                Requirements depend on the trade and location. Titan Core
                Builders may request business information, tax documentation,
                licenses, proof of insurance, coverage details, and a signed
                service partner agreement before assignments are issued.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <LeadForm />
  </main>

  <Footer showCta={false} />
</BaseLayout>
