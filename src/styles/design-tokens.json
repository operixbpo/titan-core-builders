{
  "primitive": {
    "color": {
      "paper": "#F7F6F3",
      "surface": "#FFFFFF",
      "ink": "#1A2B4A",
      "muted": "#5E6878",
      "line": "#E3E0DA",
      "hivis": "#8F4E2C",
      "hivisSoft": "#F4E7DB",
      "slate": "#3D4A5C",
      "danger": "#B42318"
    },
    "radius": {
      "xl": "34px",
      "lg": "24px",
      "md": "16px",
      "pill": "999px"
    },
    "font": {
      "sans": "Outfit Variable"
    },
    "ease": {
      "snap": "cubic-bezier(0.16, 1, 0.3, 1)"
    }
  },
  "semantic": {
    "color": {
      "bg": "{primitive.color.paper}",
      "surface": "{primitive.color.surface}",
      "fg": "{primitive.color.ink}",
      "fgMuted": "{primitive.color.muted}",
      "border": "{primitive.color.line}",
      "accent": "{primitive.color.hivis}",
      "accentSoft": "{primitive.color.hivisSoft}",
      "danger": "{primitive.color.danger}"
    }
  },
  "component": {
    "button": {
      "height": "3.25rem",
      "radius": "{primitive.radius.pill}",
      "pressScale": "0.96"
    },
    "nav": {
      "blur": "16px",
      "zIndex": 50
    },
    "card": {
      "radius": "{primitive.radius.xl}",
      "innerRadius": "22px"
    }
  }
}
