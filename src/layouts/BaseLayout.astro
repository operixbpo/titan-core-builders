---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Titan Core Builders LLC | Property Maintenance and Preservation",
  description = "Titan Core Builders LLC provides property maintenance, preservation, inspection, and repair coordination through licensed and insured service professionals across multiple U.S. markets.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#F7F6F3" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/favicon.png" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
    <script>
      import { initSite } from "../scripts/site";
      initSite();
    </script>
  </body>
</html>
