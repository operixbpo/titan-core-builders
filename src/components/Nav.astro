---
const links = [
  { href: "/", label: "Home" },
  { href: "/services", label: "Services" },
  { href: "/#about", label: "About" },
  { href: "/#coverage", label: "Coverage" },
  { href: "/contact", label: "Contact" },
];
---

<header class="nav" id="nav">
  <div class="nav-in">
    <a class="logo" href="/" aria-label="TitanCore Builders home">
      <img
        src="/titan-core-builders-logo.png"
        alt="TitanCore Builders"
        width="220"
        height="56"
      />
    </a>
    <nav class="links" id="links" aria-label="Main">
      <span class="indicator" id="indicator" aria-hidden="true"></span>
      {links.map((l) => <a href={l.href}>{l.label}</a>)}
    </nav>
    <div class="flex items-center gap-2">
      <a class="btn btn-ink" href="/contact" data-magnetic
        >Request a Quote <span class="ic" aria-hidden="true">↗</span></a
      >
      <button
        class="menu-btn"
        id="menuBtn"
        aria-expanded="false"
        aria-controls="menu">Menu</button
      >
    </div>
  </div>
</header>

<div class="menu" id="menu" role="dialog" aria-modal="true" aria-label="Menu">
  <nav aria-label="Mobile">
    {links.map((l) => <a href={l.href}>{l.label}</a>)}
    <a href="/contact#vendor">Become a Service Partner</a>
  </nav>
  <a class="btn btn-ink self-start" href="/contact"
    >Request a Quote <span class="ic" aria-hidden="true">↗</span></a
  >
</div>
