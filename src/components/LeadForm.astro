---
import { US_STATES } from "../lib/site";

interface Props {
  heading?: string;
  intro?: string;
  showContact?: boolean;
  pretitle?: boolean;
  sectionId?: string;
}

const {
  heading = "Tell Us What the Property Needs",
  intro = "Share the property location, requested service, and any available photos or scope details. Our team will review the request and contact you about availability and next steps.",
  showContact = true,
  pretitle = true,
  sectionId = "quote",
} = Astro.props;
---

<section
  class="gutter grid grid-cols-1 gap-10 pb-24 md:pb-40 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:gap-16"
  id={sectionId}
>
  <div>
    {pretitle && (
      <h2
        class="max-w-[16ch] text-[clamp(2.4rem,5vw,4.6rem)] font-semibold leading-[0.98] tracking-[-0.045em]"
      >
        {heading}
      </h2>
    )}
    <p class="mt-6 max-w-[42ch] text-muted">
      {intro}
    </p>
    {showContact && (
    <div class="mt-10 grid gap-3 text-sm text-muted">
      <p class="flex items-start gap-2.5">
        <span class="fi fi-rr-phone-call mt-0.5 icon-inline" aria-hidden="true"></span>
        <span>
          Phone:
          <a class="text-ink hover:underline" href="tel:+17035550148"
            >+1 (703) 555-0148</a
          >
          <span class="opacity-70">(placeholder)</span>
        </span>
      </p>
      <p class="flex items-start gap-2.5">
        <span class="fi fi-rr-envelope mt-0.5 icon-inline" aria-hidden="true"></span>
        <span>
          Email:
          <a class="text-ink hover:underline" href="mailto:info@TitanCoreBuilders.com"
            >info@TitanCoreBuilders.com</a
          >
        </span>
      </p>
      <p class="flex items-start gap-2.5">
        <span class="fi fi-rr-clock mt-0.5 icon-inline" aria-hidden="true"></span>
        <span>Hours: Monday–Saturday, 7:00 AM–7:00 PM ET</span>
      </p>
      <p class="flex items-start gap-2.5">
        <span class="fi fi-rr-bolt mt-0.5 icon-inline" aria-hidden="true"></span>
        <span>After-hours emergency requests accepted via phone and this form</span>
      </p>
      <p class="mt-1 flex items-start gap-2.5">
        <span class="fi fi-rr-map-marker mt-0.5 icon-inline" aria-hidden="true"></span>
        <span>
          1234 Titan Way, Suite 200, Richmond, VA 23219
          <span class="opacity-70">(placeholder)</span>
        </span>
      </p>
    </div>
    )}
  </div>

  <div
    class="rounded-[34px] bg-surface p-3 shadow-[0_30px_80px_-50px_rgb(30_34_39/0.45),inset_0_0_0_1px_rgb(30_34_39/0.05)]"
  >
    <div class="rounded-[22px] p-4 md:p-8">
      <div
        class="tabs"
        role="tablist"
        aria-label="Form type"
        id="tabs"
        data-active="0"
      >
        <span class="slide" aria-hidden="true"></span>
        <button
          role="tab"
          aria-selected="true"
          aria-controls="formQuote"
          id="tabQuote">Request a Quote</button
        >
        <button
          role="tab"
          aria-selected="false"
          aria-controls="formVendor"
          id="tabVendor"
          tabindex="-1">Become a Service Partner</button
        >
      </div>

      <form
        class="lead-form mt-8 grid grid-cols-1 gap-5 sm:grid-cols-2"
        id="formQuote"
        role="tabpanel"
        aria-labelledby="tabQuote"
        data-form="quote_request"
        novalidate
      >
        <div class="banner sm:col-span-2" role="alert" data-banner>
          Something went wrong sending this. Check your connection and try again.
        </div>
        <div class="field">
          <label for="q-name">Full name</label>
          <input
            class="input"
            id="q-name"
            name="name"
            autocomplete="name"
            required
            aria-describedby="q-name-e"
          />
          <span class="err" id="q-name-e">Enter your name.</span>
        </div>
        <div class="field">
          <label for="q-company"
            >Company name <span class="opt">(optional)</span></label
          >
          <input
            class="input"
            id="q-company"
            name="company"
            autocomplete="organization"
          />
        </div>
        <div class="field">
          <label for="q-email">Email address</label>
          <input
            class="input"
            id="q-email"
            name="email"
            type="email"
            autocomplete="email"
            required
            aria-describedby="q-email-e"
          />
          <span class="err" id="q-email-e"
            >Enter an email like name@company.com.</span
          >
        </div>
        <div class="field">
          <label for="q-phone">Phone number</label>
          <input
            class="input"
            id="q-phone"
            name="phone"
            type="tel"
            autocomplete="tel"
            required
            aria-describedby="q-phone-e"
          />
          <span class="err" id="q-phone-e"
            >Enter a phone number we can call.</span
          >
        </div>
        <div class="field sm:col-span-2">
          <label for="q-address">Property address or ZIP code</label>
          <input
            class="input"
            id="q-address"
            name="property_address"
            autocomplete="street-address"
            placeholder="Street, city, or ZIP"
            required
            aria-describedby="q-address-e"
          />
          <span class="err" id="q-address-e"
            >Enter the property address or ZIP code.</span
          >
        </div>
        <div class="field">
          <label for="q-state">State</label>
          <select
            class="input"
            id="q-state"
            name="state"
            required
            aria-describedby="q-state-e"
          >
            <option value="">Select a state</option>
            {US_STATES.map((s) => <option value={s}>{s}</option>)}
          </select>
          <span class="err" id="q-state-e">Choose the property’s state.</span>
        </div>
        <div class="field">
          <label for="q-timing"
            >Requested timing <span class="opt">(optional)</span></label
          >
          <input
            class="input"
            id="q-timing"
            name="requested_timing"
            placeholder="e.g. this week, flexible"
          />
        </div>
        <div class="field">
          <span class="legend" id="q-status-l">Property is</span>
          <div class="chips" role="radiogroup" aria-labelledby="q-status-l">
            <label class="chip"
              ><input type="radio" name="occupancy" value="vacant" checked /><span
                >Vacant</span
              ></label
            >
            <label class="chip"
              ><input type="radio" name="occupancy" value="occupied" /><span
                >Occupied</span
              ></label
            >
            <label class="chip"
              ><input type="radio" name="occupancy" value="unknown" /><span
                >Not sure</span
              ></label
            >
          </div>
        </div>
        <fieldset class="field sm:col-span-2" aria-describedby="q-services-e">
          <legend class="legend mb-2">Service category</legend>
          <div class="chips">
            <label class="chip"
              ><input type="checkbox" name="services" value="maintenance" /><span
                >Maintenance</span
              ></label
            >
            <label class="chip"
              ><input type="checkbox" name="services" value="preservation" /><span
                >Preservation</span
              ></label
            >
            <label class="chip"
              ><input type="checkbox" name="services" value="inspection" /><span
                >Inspection</span
              ></label
            >
            <label class="chip"
              ><input type="checkbox" name="services" value="repair" /><span
                >Repair</span
              ></label
            >
            <label class="chip"
              ><input type="checkbox" name="services" value="other" /><span
                >Other</span
              ></label
            >
          </div>
          <span class="err" id="q-services-e">Pick at least one category.</span>
        </fieldset>
        <div class="field sm:col-span-2">
          <label for="q-msg">Message and scope details</label>
          <textarea
            class="input"
            id="q-msg"
            name="message"
            required
            aria-describedby="q-msg-e"
            placeholder="Describe the work needed, access notes, and any deadlines"
          ></textarea>
          <span class="err" id="q-msg-e">Add a short description of the work.</span>
        </div>
        <div class="hp" aria-hidden="true">
          <label for="q-web">Website</label>
          <input id="q-web" name="website" tabindex="-1" autocomplete="off" />
        </div>
        <div class="field sm:col-span-2">
          <label class="consent">
            <input
              type="checkbox"
              name="consent"
              required
              aria-describedby="q-consent-e"
            />
            <span
              >I agree to the <a href="/privacy-policy" class="underline">Privacy Policy</a
              > and consent to being contacted about this request.</span
            >
          </label>
          <span class="err" id="q-consent-e">Please agree so we can reply.</span>
        </div>
        <div class="turnstile sm:col-span-2" aria-hidden="true">
          <i></i>Security check (Cloudflare Turnstile) appears here
        </div>
        <div
          class="flex flex-wrap items-center justify-between gap-4 sm:col-span-2"
        >
          <p class="text-sm text-muted">
            We reply by email about availability and next steps.
          </p>
          <button class="btn btn-ink" type="submit" data-submit>
            <span data-label>Submit Inquiry</span>
            <span class="ic" aria-hidden="true">↗</span>
          </button>
        </div>
      </form>

      <form
        class="lead-form mt-8 grid grid-cols-1 gap-5 sm:grid-cols-2"
        id="formVendor"
        role="tabpanel"
        aria-labelledby="tabVendor"
        data-form="vendor_application"
        novalidate
        hidden
      >
        <div class="banner sm:col-span-2" role="alert" data-banner>
          Something went wrong sending this. Check your connection and try again.
        </div>
        <p class="sm:col-span-2 text-sm text-muted">
          Titan Core Builders works with qualified property maintenance
          professionals and service companies across selected markets. Completing
          this form does not guarantee onboarding or work assignments.
        </p>
        <div class="field">
          <label for="v-name">Contact name</label>
          <input
            class="input"
            id="v-name"
            name="name"
            autocomplete="name"
            required
            aria-describedby="v-name-e"
          />
          <span class="err" id="v-name-e">Enter your name.</span>
        </div>
        <div class="field">
          <label for="v-company">Legal business name</label>
          <input
            class="input"
            id="v-company"
            name="company"
            autocomplete="organization"
            required
            aria-describedby="v-company-e"
          />
          <span class="err" id="v-company-e">Enter your legal business name.</span>
        </div>
        <div class="field">
          <label for="v-email">Email address</label>
          <input
            class="input"
            id="v-email"
            name="email"
            type="email"
            autocomplete="email"
            required
            aria-describedby="v-email-e"
          />
          <span class="err" id="v-email-e"
            >Enter an email like name@company.com.</span
          >
        </div>
        <div class="field">
          <label for="v-phone">Phone number</label>
          <input
            class="input"
            id="v-phone"
            name="phone"
            type="tel"
            autocomplete="tel"
            required
            aria-describedby="v-phone-e"
          />
          <span class="err" id="v-phone-e"
            >Enter a phone number we can call.</span
          >
        </div>
        <div class="field sm:col-span-2">
          <label for="v-address">Business address</label>
          <input
            class="input"
            id="v-address"
            name="business_address"
            autocomplete="street-address"
            required
            aria-describedby="v-address-e"
          />
          <span class="err" id="v-address-e">Enter your business address.</span>
        </div>
        <div class="field sm:col-span-2">
          <label for="v-area">Coverage states, cities, or ZIP codes</label>
          <input
            class="input"
            id="v-area"
            name="service_area"
            placeholder="e.g. VA, Richmond metro; TX — Houston"
            required
            aria-describedby="v-area-e"
          />
          <span class="err" id="v-area-e">Tell us where you can take work.</span>
        </div>
        <fieldset class="field sm:col-span-2" aria-describedby="v-trades-e">
          <legend class="legend mb-2">Trades and services offered</legend>
          <div class="chips">
            <label class="chip"
              ><input type="checkbox" name="trades" value="general" /><span
                >General maintenance</span
              ></label
            >
            <label class="chip"
              ><input type="checkbox" name="trades" value="roofing" /><span
                >Roofing</span
              ></label
            >
            <label class="chip"
              ><input type="checkbox" name="trades" value="lawn" /><span
                >Lawn and landscaping</span
              ></label
            >
            <label class="chip"
              ><input type="checkbox" name="trades" value="plumbing" /><span
                >Plumbing</span
              ></label
            >
            <label class="chip"
              ><input type="checkbox" name="trades" value="electrical" /><span
                >Electrical</span
              ></label
            >
            <label class="chip"
              ><input type="checkbox" name="trades" value="hvac" /><span
                >HVAC</span
              ></label
            >
            <label class="chip"
              ><input type="checkbox" name="trades" value="cleaning" /><span
                >Cleaning and debris</span
              ></label
            >
            <label class="chip"
              ><input type="checkbox" name="trades" value="painting" /><span
                >Painting / carpentry</span
              ></label
            >
          </div>
          <span class="err" id="v-trades-e">Pick at least one trade.</span>
        </fieldset>
        <div class="field">
          <label for="v-years"
            >Years in business <span class="opt">(optional)</span></label
          >
          <input class="input" id="v-years" name="years_in_business" type="text" />
        </div>
        <div class="field">
          <label for="v-license"
            >License information <span class="opt">(optional)</span></label
          >
          <input class="input" id="v-license" name="license_info" type="text" />
        </div>
        <div class="field">
          <span class="legend" id="v-ins-l">Insurance status</span>
          <div class="chips" role="radiogroup" aria-labelledby="v-ins-l">
            <label class="chip"
              ><input type="radio" name="insured" value="yes" checked /><span
                >Yes</span
              ></label
            >
            <label class="chip"
              ><input type="radio" name="insured" value="no" /><span>No</span
              ></label
            >
            <label class="chip"
              ><input type="radio" name="insured" value="in_progress" /><span
                >In progress</span
              ></label
            >
          </div>
        </div>
        <div class="field">
          <span class="legend" id="v-w9-l">W-9 available</span>
          <div class="chips" role="radiogroup" aria-labelledby="v-w9-l">
            <label class="chip"
              ><input type="radio" name="w9_available" value="yes" checked /><span
                >Yes</span
              ></label
            >
            <label class="chip"
              ><input type="radio" name="w9_available" value="no" /><span
                >No</span
              ></label
            >
          </div>
        </div>
        <div class="field sm:col-span-2">
          <label for="v-msg">Message <span class="opt">(optional)</span></label>
          <textarea
            class="input"
            id="v-msg"
            name="message"
            placeholder="Crew size, equipment, notes"></textarea
          >
          <span class="help"
            >Licenses, insurance certificates, and W-9 forms are requested
            through an approved secure process after initial contact — not via
            upload on this form.</span
          >
        </div>
        <div class="hp" aria-hidden="true">
          <label for="v-web">Website</label>
          <input id="v-web" name="website" tabindex="-1" autocomplete="off" />
        </div>
        <div class="field sm:col-span-2">
          <label class="consent">
            <input
              type="checkbox"
              name="consent"
              required
              aria-describedby="v-consent-e"
            />
            <span
              >I certify that the information submitted is accurate and agree to
              the <a href="/privacy-policy" class="underline">Privacy Policy</a>.</span
            >
          </label>
          <span class="err" id="v-consent-e">Please agree so we can reply.</span>
        </div>
        <div class="turnstile sm:col-span-2" aria-hidden="true">
          <i></i>Security check (Cloudflare Turnstile) appears here
        </div>
        <div
          class="flex flex-wrap items-center justify-between gap-4 sm:col-span-2"
        >
          <p class="text-sm text-muted">
            Payment terms are confirmed during onboarding.
          </p>
          <button class="btn btn-ink" type="submit" data-submit>
            <span data-label>Submit Partner Information</span>
            <span class="ic" aria-hidden="true">↗</span>
          </button>
        </div>
      </form>

      <div class="success mt-8 gap-5" id="success" tabindex="-1" aria-live="polite">
        <span class="ok-badge" aria-hidden="true">✓</span>
        <div>
          <h3
            class="text-[2rem] font-semibold leading-none tracking-[-0.035em]"
            id="successTitle"
          >
            Thank you. Your request has been received.
          </h3>
          <p class="mt-3 max-w-[44ch] text-muted" id="successText">
            A member of our team will review the information and contact you
            about the next step.
          </p>
        </div>
        <div class="grid gap-2 rounded-2xl bg-paper p-4 text-sm">
          <div class="flex justify-between">
            <span class="text-muted">Reference</span>
            <b class="font-semibold" id="refId">TCB-0000</b>
          </div>
          <div class="flex justify-between">
            <span class="text-muted">Sent to</span>
            <b class="font-semibold">info@TitanCoreBuilders.com</b>
          </div>
        </div>
        <p class="text-xs text-muted">
          Form posts to the Lead Gateway when PUBLIC_LEADS_URL is set. Until then,
          submit is mocked locally.
        </p>
        <button class="btn btn-line justify-self-start" type="button" id="again"
          >Send another</button
        >
      </div>
    </div>
  </div>
</section>
